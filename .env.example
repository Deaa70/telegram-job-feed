# Copy to .env and fill in. Never commit .env.

# Telegram account that reads the channels (the spare one). API_ID / API_HASH: https://my.telegram.org
API_ID=
API_HASH=
# Created by: python login.py
TELEGRAM_SESSION=

# Any OpenAI-compatible API
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Your bot (from @BotFather) and your private channel id (like -1001234567890). The bot must be a channel admin.
BOT_TOKEN=
NOTIFY_CHAT_ID=

# Where the SQLite file lives. Locally ./data. On the server use a persistent volume, e.g. /data
# DATA_DIR=./data
